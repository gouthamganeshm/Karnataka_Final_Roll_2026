# Runs scripts/home/ds_pilot.py --vm K on VM K (eci-K): the open dataset
# (docs/dataset.md, English roll), restarted after any crash or
# reboot. Install (as ubuntu, repo at ~/verify, token in ~/.gh_token):
#   sudo cp ~/verify/scripts/home/ds-pilot@.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ds-pilot@K
# Log: journalctl -u ds-pilot@K -f
[Unit]
Description=Karnataka final roll: open dataset, VM %i
Wants=network-online.target
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/verify
ExecStartPre=/bin/bash -c 'git pull -q || true'
ExecStart=/bin/bash -c 'GH_TOKEN=$(cat /home/ubuntu/.gh_token) exec nice -n 5 /home/ubuntu/venv/bin/python -u -W ignore scripts/home/ds_pilot.py --vm %i'
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
